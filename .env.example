# RideNow Platform - Environment Configuration

# Server
PORT=5050
NODE_ENV=development
CORS_ORIGIN=*

# PostgreSQL Database (Production)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/ridenow?schema=public

# Security & JWT
JWT_SECRET=ridenow_super_secret_jwt_key_2026_india
JWT_EXPIRES_IN=7d

# Payment Gateway (Razorpay India)
RAZORPAY_KEY_ID=rzp_test_ridenow_demo_key
RAZORPAY_KEY_SECRET=rzp_secret_demo_token
RAZORPAY_IS_LIVE=false

# Google Maps API
GOOGLE_MAPS_API_KEY=DEMO_MAPS_KEY_INDIA

# National Emergency Helpline
EMERGENCY_HELPLINE=112

